{
  "name": "argus-claude",
  "displayName": "Argus - Claude Code Agent Monitoring & Observability on VSCode",
  "description": "Monitoring and observability for Claude Code agent sessions inside VS Code — live transcripts, cost telemetry, context-window metrics, dependency graphs, and rule-based analysis of tool calls, retry loops, and compaction events.",
  "version": "0.3.7",
  "publisher": "argus-claude",
  "author": {
    "name": "Ozgur Kurucan",
    "email": "ozgurkurucan337@gmail.com"
  },
  "license": "MIT",
  "icon": "icon-128.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat",
    "Visualization",
    "Debuggers",
    "Data Science",
    "Education"
  ],
  "keywords": [
    "argus",
    "claude",
    "claude-code",
    "claude code",
    "anthropic",
    "agent",
    "ai-agent",
    "agent-monitoring",
    "agent-observability",
    "observability",
    "monitoring",
    "telemetry",
    "tracing",
    "llm",
    "llm-observability",
    "llm-monitoring",
    "session-analysis",
    "session-debugger",
    "transcript",
    "jsonl",
    "tool-calls",
    "subagent",
    "cost-tracking",
    "token-usage",
    "context-window",
    "cache-hit-ratio",
    "performance",
    "analytics",
    "dashboard",
    "developer-tools",
    "vscode-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yessGlory17/argus.git"
  },
  "bugs": {
    "url": "https://github.com/yessGlory17/argus/issues"
  },
  "homepage": "https://github.com/yessGlory17/argus#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "argus",
          "title": "Argus",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "argus": [
        {
          "id": "argusSessionList",
          "name": "%view.sessions.name%",
          "type": "webview",
          "contextualTitle": "%view.sessions.contextualTitle%"
        }
      ]
    },
    "commands": [
      {
        "command": "argus.refreshSessions",
        "title": "%command.refreshSessions.title%",
        "icon": "$(refresh)",
        "category": "Argus"
      },
      {
        "command": "argus.openSessionDetail",
        "title": "%command.openSessionDetail.title%",
        "category": "Argus"
      },
      {
        "command": "argus.openSessionTab",
        "title": "%command.openSessionTab.title%",
        "category": "Argus"
      },
      {
        "command": "argus.toggleModelOpus",
        "title": "%command.toggleModelOpus.title%",
        "category": "Argus"
      },
      {
        "command": "argus.toggleModelSonnet",
        "title": "%command.toggleModelSonnet.title%",
        "category": "Argus"
      },
      {
        "command": "argus.toggleModelHaiku",
        "title": "%command.toggleModelHaiku.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setDateAll",
        "title": "%command.setDateAll.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setDate1h",
        "title": "%command.setDate1h.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setDate3h",
        "title": "%command.setDate3h.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setDate6h",
        "title": "%command.setDate6h.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setDate24h",
        "title": "%command.setDate24h.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setDate7d",
        "title": "%command.setDate7d.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setDate30d",
        "title": "%command.setDate30d.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setDateCustom",
        "title": "%command.setDateCustom.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setGroupNone",
        "title": "%command.setGroupNone.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setGroupProject",
        "title": "%command.setGroupProject.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setGroupModel",
        "title": "%command.setGroupModel.title%",
        "category": "Argus"
      },
      {
        "command": "argus.setGroupDate",
        "title": "%command.setGroupDate.title%",
        "category": "Argus"
      },
      {
        "command": "argus.filterCurrentProjectOn",
        "title": "%command.filterCurrentProjectOn.title%",
        "icon": "$(filter)",
        "category": "Argus"
      },
      {
        "command": "argus.filterCurrentProjectOff",
        "title": "%command.filterCurrentProjectOff.title%",
        "icon": "$(filter-filled)",
        "category": "Argus"
      },
      {
        "command": "argus.openWorkspaceDashboard",
        "title": "%command.openWorkspaceDashboard.title%",
        "icon": "$(dashboard)",
        "category": "Argus"
      }
    ],
    "submenus": [
      {
        "id": "argus.groupMenu",
        "label": "%submenu.groupMenu.label%",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "argus.openWorkspaceDashboard",
          "when": "view == argusSessionList",
          "group": "navigation@0"
        },
        {
          "command": "argus.filterCurrentProjectOn",
          "when": "view == argusSessionList && !argus.filter.currentProject",
          "group": "navigation@1"
        },
        {
          "command": "argus.filterCurrentProjectOff",
          "when": "view == argusSessionList && argus.filter.currentProject",
          "group": "navigation@1"
        },
        {
          "submenu": "argus.groupMenu",
          "when": "view == argusSessionList",
          "group": "navigation@2"
        },
        {
          "command": "argus.refreshSessions",
          "when": "view == argusSessionList",
          "group": "navigation@3"
        }
      ],
      "argus.groupMenu": [
        {
          "command": "argus.setGroupNone",
          "group": "group@1"
        },
        {
          "command": "argus.setGroupProject",
          "group": "group@2"
        },
        {
          "command": "argus.setGroupModel",
          "group": "group@3"
        },
        {
          "command": "argus.setGroupDate",
          "group": "group@4"
        }
      ]
    },
    "configuration": {
      "title": "Argus",
      "properties": {
        "argus.scanDepth": {
          "type": "number",
          "default": 5,
          "description": "%config.scanDepth.description%"
        },
        "argus.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-TW"
          ],
          "description": "%config.language.description%",
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "繁體中文"
          ]
        },
        "argus.openLocation": {
          "type": "string",
          "default": "active",
          "enum": [
            "active",
            "beside"
          ],
          "enumDescriptions": [
            "%config.openLocation.enum.active%",
            "%config.openLocation.enum.beside%"
          ],
          "description": "%config.openLocation.description%"
        },
        "argus.delete.useTrash": {
          "type": "boolean",
          "default": true,
          "description": "%config.delete.useTrash.description%"
        },
        "argus.searchBar.showModelSelector": {
          "type": "boolean",
          "default": true,
          "description": "%config.searchBar.showModelSelector.description%"
        },
        "argus.sessionList.showModel": {
          "type": "boolean",
          "default": true,
          "description": "%config.sessionList.showModel.description%"
        },
        "argus.sessionList.showProject": {
          "type": "boolean",
          "default": true,
          "description": "%config.sessionList.showProject.description%"
        },
        "argus.steps.sortOrder": {
          "type": "string",
          "default": "newest",
          "enum": [
            "newest",
            "oldest",
            "cost-desc",
            "cost-asc"
          ],
          "enumDescriptions": [
            "%config.steps.sortOrder.enum.newest%",
            "%config.steps.sortOrder.enum.oldest%",
            "%config.steps.sortOrder.enum.cost-desc%",
            "%config.steps.sortOrder.enum.cost-asc%"
          ],
          "description": "%config.steps.sortOrder.description%"
        },
        "argus.steps.autoExpand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.steps.autoExpand.markdownDescription%",
          "examples": [
            [
              "text",
              "thinking"
            ],
            [
              "Read",
              "Bash",
              "mcp*"
            ],
            [
              "*"
            ]
          ]
        },
        "argus.notes.hideNotes": {
          "type": "boolean",
          "default": false,
          "description": "%config.notes.hideNotes.description%"
        },
        "argus.analysis.realCompactsOnly": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.analysis.realCompactsOnly.markdownDescription%"
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf out",
    "vscode:prepublish": "npm run clean && npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "vite build",
    "dev:webview": "vite",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^8.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.0.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/diff": "^7.0.2",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.575.0",
    "marked": "^18.0.3",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "recharts": "^3.7.0"
  }
}
